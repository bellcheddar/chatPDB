[Unit]
Description=chatPDB Web App (xterm.js + PTY)
After=network.target

[Service]
Type=simple
User=chatpdb
WorkingDirectory=/opt/chatpdb/web/flask_app
EnvironmentFile=/opt/chatpdb/web/flask_app/.env
ExecStart=/opt/chatpdb/web/flask_app/.venv/bin/gunicorn -k gevent -w 1 --worker-connections 100 -b 127.0.0.1:8002 --timeout 300 wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
