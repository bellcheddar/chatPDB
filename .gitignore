# Third-party tool binaries/builds (Foldseek DB, cctbx bootstrap, etc. -- large, machine-specific,
# re-buildable from scripts/build_foldseek_db.py / tools/cctbx/bootstrap.py, never commit)
tools/

# Data and models (never commit corpora, weights, or adapters)
data/corpus/
data/sft/*.jsonl
data/structures/
data/structures_all/
data/structures_pool_ids.csv
data/cache/
adapters/
fused_model/
models/
!models/*/README.md
exports/
*.gguf
*.safetensors
*.npz
outputs/
logs/
!logs/*_train.log
.chroma/
*.lance/

# W&B local run artifacts
wandb/

# Secrets
.env
.webui_secret_key

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
